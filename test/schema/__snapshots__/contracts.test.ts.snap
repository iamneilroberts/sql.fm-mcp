        },
        "disclaimer": {
          "description": "Accuracy and non-affiliation disclaimer.",
          "type": "string",
        },
        "query_interpretation": {
          "additionalProperties": false,
          "properties": {
            "filters": {
              "additionalProperties": false,
              "properties": {
                "category": {
                  "type": [
                    "string",
                    "null",
                  ],
                },
                "environment": {
                  "type": [
                    "string",
                    "null",
                  ],
                },
                "status": {
                  "type": [
                    "string",
                    "null",
                  ],
                },
              },
              "required": [
                "category",
                "environment",
                "status",
              ],
              "type": "object",
            },
            "normalized_query": {
              "type": "string",
            },
            "synonyms_applied": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "tokens": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
          },
          "required": [
            "normalized_query",
            "tokens",
            "synonyms_applied",
            "filters",
          ],
          "type": "object",
        },
        "results": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "category": {
                "type": "string",
              },
              "id": {
                "description": "Feature id (slug). Pass to fetch or compare_feature_support.",
                "type": "string",
              },
              "match_reason": {
                "enum": [
                  "exact_slug",
                  "exact_name",
                  "alias",
                  "prefix",
                  "tokens",
                  "description",
                  "fuzzy",
                ],
                "type": "string",
              },
              "score": {
                "description": "Relevance score, 0-1000. Higher is a stronger match.",
                "type": "number",
              },
              "summary": {
                "type": "string",
              },
              "title": {
                "type": "string",
              },
              "url": {
                "description": "Canonical SQL.FM URL. Use this to cite the result.",
                "type": "string",
              },
            },
            "required": [
              "id",
              "title",
              "url",
              "summary",
              "category",
              "score",
              "match_reason",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "source": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
            },
            "url": {
              "type": "string",
            },
          },
          "required": [
            "name",
            "url",
          ],
          "type": "object",
        },
        "suggestions": {
          "description": "Nearest feature ids, when the search found nothing.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "total_matched": {
          "description": "Matches before \`limit\` was applied.",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
        "truncated": {
          "type": "boolean",
        },
