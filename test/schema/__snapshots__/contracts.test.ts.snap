  "search": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "category": {
          "description": "Restrict to a SQL.FM category, e.g. "Indexing", "Security". See sqlfm://categories.",
          "maxLength": 80,
          "type": "string",
        },
        "environment": {
          "description": "Restrict to features with the given status in one environment. Grammar: "mssql-<year>" for a whole release (all editions), "mssql-<year>-<edition>" where edition is standard|enterprise|developer|express, "azure-sql-db" for Azure SQL Database, "azure-sql-mi" for Azure SQL Managed Instance. Examples: "mssql-2019", "mssql-2019-standard", "azure-sql-db".",
          "maxLength": 60,
          "type": "string",
        },
        "limit": {
          "default": 10,
          "description": "Maximum results to return (1-50).",
          "maximum": 50,
          "minimum": 1,
          "type": "integer",
        },
        "query": {
          "description": "Feature name, keyword, or natural-language question. Examples: "STRING_AGG", "online index rebuild", "which version added DATE_BUCKET".",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "status": {
          "description": "Used with \`environment\`: keep only features with this status there. Defaults to "available".",
          "enum": [
            "available",
            "unavailable",
            "conditional",
            "preview",
            "not_applicable",
            "unknown",
          ],
          "type": "string",
        },
      },
      "required": [
        "query",
      ],
      "type": "object",
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "description": "Required attribution for this data.",
