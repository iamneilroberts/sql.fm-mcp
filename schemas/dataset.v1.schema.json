{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sql.fm/schemas/dataset.v1.schema.json",
  "title": "SQL.FM MCP dataset (dataset.v1)",
  "description": "The normalized dataset consumed by the SQL.FM MCP server. See docs/data-schema.md. Note the closed support vocabulary: \"unknown\" and \"not_applicable\" are absence of data and a statement about history respectively, and must never be rendered as \"unavailable\".",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "generated_at": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "url": {
          "type": "string",
          "maxLength": 500
        },
        "feature_url_template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "disclaimer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "name",
        "url",
        "feature_url_template",
        "attribution",
        "disclaimer"
      ],
      "additionalProperties": false
    },
    "releases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "major": {
            "type": "string",
            "maxLength": 32
          },
          "year": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "sort": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "name",
          "major",
          "year",
          "sort"
        ],
        "additionalProperties": false
      }
    },
    "editions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "standard",
              "enterprise",
              "developer",
              "express"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "sort": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "name",
          "sort"
        ],
        "additionalProperties": false
      }
    },
    "cloud_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "short": {
            "type": "string",
            "maxLength": 64
          },
          "docs": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "sort": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "name",
          "short",
          "docs",
          "sort"
        ],
        "additionalProperties": false
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "parent_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "sort": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "name",
          "parent_id",
          "parent_name",
          "sort"
        ],
        "additionalProperties": false
      }
    },
    "support_matrix": {
      "type": "object",
      "properties": {
        "encoding": {
          "type": "string",
          "const": "compact-v1"
        },
        "legend": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "available",
              "unavailable",
              "conditional",
              "preview",
              "not_applicable",
              "unknown"
            ]
          }
        },
        "release_order": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "edition_order": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "standard",
              "enterprise",
              "developer",
              "express"
            ]
          }
        },
        "rows": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "encoding",
        "legend",
        "release_order",
        "edition_order",
        "rows"
      ],
      "additionalProperties": false
    },
    "features": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "upstream_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "url": {
            "type": "string",
            "maxLength": 500
          },
          "type": {
            "type": "string",
            "maxLength": 120
          },
          "category": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "parent_name": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 120
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "name",
              "parent_name"
            ],
            "additionalProperties": false
          },
          "summary": {
            "type": "string",
            "maxLength": 4000
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120
            }
          },
          "microsoft_docs": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "cloud_support": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 64
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "available",
                    "unavailable",
                    "conditional",
                    "preview",
                    "not_applicable",
                    "unknown"
                  ]
                },
                "note": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 4000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              },
              "required": [
                "status",
                "note",
                "sources"
              ],
              "additionalProperties": false
            }
          },
          "timeline": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "event": {
                  "type": "string",
                  "maxLength": 64
                },
                "environment": {
                  "type": "string",
                  "maxLength": 64
                },
                "edition": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "standard",
                        "enterprise",
                        "developer",
                        "express"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "summary": {
                  "type": "string",
                  "maxLength": 4000
                },
                "source": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 500
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "event",
                "environment",
                "edition",
                "summary",
                "source"
              ],
              "additionalProperties": false
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "environment": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 64
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "edition": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "standard",
                        "enterprise",
                        "developer",
                        "express"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "note": {
                  "type": "string",
                  "maxLength": 4000
                },
                "source": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 500
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "environment",
                "edition",
                "note",
                "source"
              ],
              "additionalProperties": false
            }
          },
          "requirements": {
            "type": "object",
            "properties": {
              "compatibility_level": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "platform": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "other": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 500
                }
              }
            },
            "required": [
              "compatibility_level",
              "platform",
              "other"
            ],
            "additionalProperties": false
          },
          "attributes": {
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "id",
          "upstream_id",
          "name",
          "slug",
          "url",
          "type",
          "category",
          "summary",
          "aliases",
          "microsoft_docs",
          "cloud_support",
          "timeline",
          "conditions",
          "requirements",
          "attributes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "dataset_version",
    "generated_at",
    "source",
    "releases",
    "editions",
    "cloud_targets",
    "categories",
    "support_matrix",
    "features"
  ],
  "additionalProperties": false
}
